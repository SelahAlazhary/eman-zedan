{
  "rules": {
    ".read": false,
    ".write": false,
    "platform": {
      ".read": false,
      ".write": false,
      "users": {
        "$index": {
          ".validate": "newData.hasChildren(['id','name','role','username','passwordHash','salt','createdAt'])",
          "role": {
            ".validate": "newData.val() === 'admin' || newData.val() === 'student'"
          },
          "username": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "passwordHash": {
            ".validate": "newData.isString() && newData.val().length >= 32"
          },
          "salt": {
            ".validate": "newData.isString() && newData.val().length >= 16"
          },
          "active": {
            ".validate": "newData.isBoolean()"
          },
          "deviceId": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "pushSubs": {
            "$sub": {
              ".validate": "newData.hasChildren(['endpoint','p256dh','auth'])",
              "endpoint": {
                ".validate": "newData.isString() && newData.val().beginsWith('https://')"
              }
            }
          },
          "subscriptions": {
            "$sub": {
              ".validate": "newData.hasChildren(['id','subjectId','activatedAt'])",
              "expiresAt": {
                ".validate": "newData.isString() || newData.val() === null"
              }
            }
          },
          "$other": {
            ".validate": true
          }
        }
      },
      "codes": {
        "$index": {
          ".validate": "newData.hasChildren(['code','status'])",
          "code": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "status": {
            ".validate": "newData.val() === 'متاح' || newData.val() === 'مستخدم' || newData.val() === 'منتهي'"
          },
          "$other": {
            ".validate": true
          }
        }
      },
      "subjects": {
        "$index": {
          ".validate": "newData.hasChildren(['id','name'])",
          "price": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "term": {
            ".validate": "newData.val() === 1 || newData.val() === 2"
          },
          "$other": {
            ".validate": true
          }
        }
      },
      "plans": {
        "$index": {
          ".validate": "newData.hasChildren(['id','name','kind','scope'])",
          "price": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "scope": {
            ".validate": "newData.val() === 'all' || newData.val() === 'term' || newData.val() === 'subject'"
          },
          "$other": {
            ".validate": true
          }
        }
      },
      "exams": {
        "$index": {
          ".validate": "newData.hasChildren(['id','title'])",
          "$other": {
            ".validate": true
          }
        }
      },
      "integrations": {
        ".read": false,
        ".write": false
      },
      "$other": {
        ".validate": true
      }
    },
    "backups": {
      ".read": false,
      ".write": false
    },
    "__health": {
      ".read": false,
      ".write": false
    }
  }
}
